rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function userExists() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isTeacher() {
      return userExists() && getUserRole() == 'teacher';
    }

    function isParent() {
      return userExists() && getUserRole() == 'parent';
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    // Role yoksa / users doc gecikmeli yazıldıysa bile kendi teacherId verisine erişim
    function ownsTeacherData() {
      return isAuthenticated() && resource.data.teacherId == request.auth.uid;
    }

    function createsAsSelfTeacher() {
      return isAuthenticated() && request.resource.data.teacherId == request.auth.uid;
    }

    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid);
      allow update: if isOwner(uid);
      allow delete: if isOwner(uid);
    }

    match /teacher_profiles/{uid} {
      allow read: if isOwner(uid);
      allow write: if isOwner(uid);
    }

    match /parent_profiles/{uid} {
      allow read: if isOwner(uid);
      allow write: if isOwner(uid);
    }

    match /classes/{classId} {
      allow read: if isAuthenticated() &&
        (resource.data.teacherId == request.auth.uid || isParent());
      allow create: if isAuthenticated() && createsAsSelfTeacher();
      allow update, delete: if ownsTeacherData();
    }

    match /students/{studentId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && createsAsSelfTeacher();
      allow update: if ownsTeacherData() ||
        (isAuthenticated() &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['parentIds']));
      allow delete: if ownsTeacherData();
    }

    match /invite_codes/{code} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update: if true;
    }

    // Ödevler — teacherId eşleşmesi (role get() bağımlılığı kaldırıldı)
    match /homeworks/{homeworkId} {
      allow read: if ownsTeacherData() || isParent();
      allow create: if createsAsSelfTeacher();
      allow update, delete: if ownsTeacherData();
    }

    match /homework_assignments/{assignmentId} {
      allow read: if ownsTeacherData() || isParent();
      allow create: if createsAsSelfTeacher();
      allow update, delete: if ownsTeacherData();
    }

    match /exam_results/{examId} {
      allow read: if ownsTeacherData() || isParent();
      allow create: if createsAsSelfTeacher();
      allow update, delete: if ownsTeacherData();
    }

    match /subject_progress/{progressId} {
      allow read: if ownsTeacherData() || isParent();
      allow create: if createsAsSelfTeacher();
      allow update, delete: if ownsTeacherData();
    }

    match /goals/{goalId} {
      allow read: if ownsTeacherData() || isParent();
      allow create: if createsAsSelfTeacher();
      allow update, delete: if ownsTeacherData();
    }

    match /messages/{messageId} {
      allow read: if ownsTeacherData() ||
        (isParent() && request.auth.uid in resource.data.parentIds);
      allow create: if createsAsSelfTeacher();
      allow update: if ownsTeacherData();
    }

    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() &&
        resource.data.userId == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead']);
    }
  }
}

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isTeacher() {
      return isAuthenticated() && getUserRole() == 'teacher';
    }

    function isParent() {
      return isAuthenticated() && getUserRole() == 'parent';
    }

    function isAdmin() {
      return isAuthenticated() && getUserRole() == 'admin';
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    function isParentOfStudent(studentId) {
      return isParent() &&
        request.auth.uid in get(/databases/$(database)/documents/students/$(studentId)).data.parentIds;
    }

    function onlyOwnUidAddedToParentIds() {
      return request.resource.data.parentIds.hasAll(resource.data.parentIds) &&
        request.resource.data.parentIds.size() == resource.data.parentIds.size() + 1 &&
        request.auth.uid in request.resource.data.parentIds &&
        !(request.auth.uid in resource.data.parentIds);
    }

    function teacherOwnsCreate() {
      return isTeacher() && request.resource.data.teacherId == request.auth.uid;
    }

    function teacherOwnsResource() {
      return isTeacher() && resource.data.teacherId == request.auth.uid;
    }

    function teacherOwnsStudent(studentId) {
      return get(/databases/$(database)/documents/students/$(studentId)).data.teacherId
        == request.auth.uid;
    }

    /// Create/update homework: her studentId bu öğretmene ait olmalı (max 20).
    function homeworkStudentIdsOwned() {
      let ids = request.resource.data.studentIds;
      return ids is list &&
        ids.size() >= 1 &&
        ids.size() <= 20 &&
        (ids.size() < 1 || teacherOwnsStudent(ids[0])) &&
        (ids.size() < 2 || teacherOwnsStudent(ids[1])) &&
        (ids.size() < 3 || teacherOwnsStudent(ids[2])) &&
        (ids.size() < 4 || teacherOwnsStudent(ids[3])) &&
        (ids.size() < 5 || teacherOwnsStudent(ids[4])) &&
        (ids.size() < 6 || teacherOwnsStudent(ids[5])) &&
        (ids.size() < 7 || teacherOwnsStudent(ids[6])) &&
        (ids.size() < 8 || teacherOwnsStudent(ids[7])) &&
        (ids.size() < 9 || teacherOwnsStudent(ids[8])) &&
        (ids.size() < 10 || teacherOwnsStudent(ids[9])) &&
        (ids.size() < 11 || teacherOwnsStudent(ids[10])) &&
        (ids.size() < 12 || teacherOwnsStudent(ids[11])) &&
        (ids.size() < 13 || teacherOwnsStudent(ids[12])) &&
        (ids.size() < 14 || teacherOwnsStudent(ids[13])) &&
        (ids.size() < 15 || teacherOwnsStudent(ids[14])) &&
        (ids.size() < 16 || teacherOwnsStudent(ids[15])) &&
        (ids.size() < 17 || teacherOwnsStudent(ids[16])) &&
        (ids.size() < 18 || teacherOwnsStudent(ids[17])) &&
        (ids.size() < 19 || teacherOwnsStudent(ids[18])) &&
        (ids.size() < 20 || teacherOwnsStudent(ids[19]));
    }

    /// parent_profiles.studentIds: yalnızca students.parentIds içinde olan ID'ler (max 10).
    function parentProfileStudentIdsLinked() {
      let ids = request.resource.data.get('studentIds', []);
      return ids is list &&
        ids.size() <= 10 &&
        (ids.size() < 1 || isParentOfStudent(ids[0])) &&
        (ids.size() < 2 || isParentOfStudent(ids[1])) &&
        (ids.size() < 3 || isParentOfStudent(ids[2])) &&
        (ids.size() < 4 || isParentOfStudent(ids[3])) &&
        (ids.size() < 5 || isParentOfStudent(ids[4])) &&
        (ids.size() < 6 || isParentOfStudent(ids[5])) &&
        (ids.size() < 7 || isParentOfStudent(ids[6])) &&
        (ids.size() < 8 || isParentOfStudent(ids[7])) &&
        (ids.size() < 9 || isParentOfStudent(ids[8])) &&
        (ids.size() < 10 || isParentOfStudent(ids[9]));
    }

    function parentStudentIds() {
      return get(/databases/$(database)/documents/parent_profiles/$(request.auth.uid))
        .data.get('studentIds', []);
    }

    /// Veli ödev okuma: studentIds ∩ parent_profiles.studentIds.
    /// studentIds yazımı parentProfileStudentIdsLinked ile kilitli.
    function parentCanReadHomework() {
      return isParent() &&
        resource.data.keys().hasAny(['studentIds']) &&
        resource.data.studentIds.hasAny(parentStudentIds());
    }

    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid) && request.resource.data.role in ['teacher', 'parent'];
      allow update: if isOwner(uid) &&
        (!request.resource.data.keys().hasAny(['role']) ||
         request.resource.data.role == resource.data.role);
      allow delete: if false;
    }

    match /teacher_profiles/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow write: if isOwner(uid);
    }

    match /parent_profiles/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid) &&
        (
          !('studentIds' in request.resource.data.keys()) ||
          request.resource.data.studentIds.size() == 0 ||
          parentProfileStudentIdsLinked()
        );
      allow update: if isOwner(uid) &&
        (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['studentIds']) ||
          parentProfileStudentIdsLinked()
        );
      allow delete: if isOwner(uid);
    }

    match /classes/{classId} {
      allow read: if isAdmin() || teacherOwnsResource();
      allow create: if teacherOwnsCreate();
      allow update: if teacherOwnsResource() &&
        request.resource.data.teacherId == resource.data.teacherId;
      allow delete: if teacherOwnsResource();
    }

    match /students/{studentId} {
      allow read: if isAdmin() ||
        teacherOwnsResource() ||
        isParentOfStudent(studentId);
      allow create: if teacherOwnsCreate();
      allow update: if (teacherOwnsResource() &&
          request.resource.data.teacherId == resource.data.teacherId) ||
        (isParent() &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['parentIds']) &&
          onlyOwnUidAddedToParentIds());
      allow delete: if teacherOwnsResource();
    }

    match /invite_codes/{code} {
      // Anonim get: yalnızca aktif sınıf kodu veya kullanılmamış öğrenci kodu.
      // Kullanılmış kodlar artık auth ile de okunmaz (enumeration).
      allow get: if resource.data.get('revoked', false) == false &&
        (
          resource.data.get('type', 'student') == 'class' ||
          resource.data.used == false
        );
      allow list: if isTeacher() || isAdmin();
      allow create: if isTeacher() &&
        request.resource.data.teacherId == request.auth.uid;
      allow update: if (isTeacher() &&
          resource.data.teacherId == request.auth.uid) ||
        (isParent() &&
          resource.data.get('type', 'student') != 'class' &&
          resource.data.used == false &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['used', 'usedBy', 'usedAt']) &&
          request.resource.data.used == true &&
          request.resource.data.usedBy == request.auth.uid);
    }

    match /homeworks/{homeworkId} {
      allow get: if isAdmin() ||
        teacherOwnsResource() ||
        parentCanReadHomework();
      allow list: if isAdmin() ||
        (isTeacher() && resource.data.teacherId == request.auth.uid);
      allow create: if teacherOwnsCreate() &&
        request.resource.data.keys().hasAll(['studentIds']) &&
        homeworkStudentIdsOwned();
      allow update: if teacherOwnsResource() &&
        request.resource.data.teacherId == resource.data.teacherId &&
        (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['studentIds']) ||
          homeworkStudentIdsOwned()
        );
      allow delete: if teacherOwnsResource();
    }

    match /homework_assignments/{assignmentId} {
      allow get: if isAdmin() ||
        teacherOwnsResource() ||
        (isParent() && isParentOfStudent(resource.data.studentId));
      allow list: if isAdmin() ||
        (isTeacher() && resource.data.teacherId == request.auth.uid) ||
        (isParent() && isParentOfStudent(resource.data.studentId));
      allow create: if teacherOwnsCreate() &&
        teacherOwnsStudent(request.resource.data.studentId);
      allow update: if teacherOwnsResource() &&
        request.resource.data.teacherId == resource.data.teacherId;
      allow delete: if teacherOwnsResource();
    }

    match /exam_results/{examId} {
      allow get: if isAdmin() ||
        teacherOwnsResource() ||
        (isParent() && isParentOfStudent(resource.data.studentId));
      allow list: if isAdmin() ||
        (isTeacher() && resource.data.teacherId == request.auth.uid) ||
        (isParent() && isParentOfStudent(resource.data.studentId));
      allow create: if teacherOwnsCreate() &&
        teacherOwnsStudent(request.resource.data.studentId);
      allow update: if teacherOwnsResource() &&
        request.resource.data.teacherId == resource.data.teacherId;
      allow delete: if teacherOwnsResource();
    }

    match /subject_progress/{progressId} {
      allow read: if isAdmin() ||
        teacherOwnsResource() ||
        (isParent() && isParentOfStudent(resource.data.studentId));
      allow create: if teacherOwnsCreate();
      allow update: if teacherOwnsResource() &&
        request.resource.data.teacherId == resource.data.teacherId;
      allow delete: if teacherOwnsResource();
    }

    match /goals/{goalId} {
      allow read: if isAdmin() ||
        teacherOwnsResource() ||
        (isParent() && isParentOfStudent(resource.data.studentId));
      allow create: if teacherOwnsCreate();
      allow update: if teacherOwnsResource() &&
        request.resource.data.teacherId == resource.data.teacherId;
      allow delete: if teacherOwnsResource();
    }

    match /messages/{messageId} {
      allow read: if isAdmin() ||
        teacherOwnsResource() ||
        (isParent() && request.auth.uid in resource.data.parentIds);
      allow create: if teacherOwnsCreate();
      allow update: if teacherOwnsResource() &&
        request.resource.data.teacherId == resource.data.teacherId;
    }

    match /notifications/{notificationId} {
      allow read: if isAuthenticated() &&
        resource.data.userId == request.auth.uid;
      // Öğretmen mesaj bildirimi; alanlar kısıtlı (App Check Faz 8).
      allow create: if isTeacher() &&
        request.resource.data.keys().hasAll(['userId', 'title', 'body', 'type', 'isRead']) &&
        request.resource.data.userId is string &&
        request.resource.data.title is string &&
        request.resource.data.body is string &&
        request.resource.data.isRead == false &&
        request.resource.data.type in ['message', 'homework', 'exam', 'system'];
      allow update: if isAuthenticated() &&
        resource.data.userId == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead']);
    }

    match /admin_broadcasts/{broadcastId} {
      allow read: if isAdmin();
      allow write: if false;
    }
  }
}
